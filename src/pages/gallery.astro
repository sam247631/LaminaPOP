---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import LangToggle from '../components/LangToggle.astro';

const images = [
  '0073','0039','0028','0052','0055','0063','0059','0077','0054','0091',
  '0044','0011','0080','0013','0012','0035','0050','0057','0058','0046',
  '0074','0014','0056','0018','0004','0029','0051','0090','0064','0078',
  '0042','0027','0002','0006','0020','0075','0047','0081','0030','0033',
  '0068','0026','0086','0036','0083','0003','0082','0061','0009','0010',
  '0079','0041','0076','0048','0094','0034','0037','0085','0062','0005',
  '0072','0049','0016','0017','0007','0070','0092','0025','0001','0022',
  '0067','0019','0023','0021','0015','0089','0045','0060','0071','0043',
  '0040','0038','0087','0065','0008','0093','0032','0053','0088','0084',
  '0066','0024','0031','0069',
];
---

<Base title="Gallery — Lamina POP">
  <Nav />
  <LangToggle />

  <main class="min-h-screen bg-white pt-[52px]">
    <div class="masonry px-1 py-1 pb-8 md:px-2 md:py-2">
      {images.map((n) => (
        <div class="masonry-item">
          <img
            src={`/gallery/${n}.jpg`}
            alt=""
            loading="lazy"
            decoding="async"
            class="gallery-img"
            data-src={`/gallery/${n}.jpg`}
            onerror="this.closest('.masonry-item').style.display='none'"
          />
        </div>
      ))}
    </div>
  </main>

  <!-- Lightbox -->
  <div id="lightbox" aria-hidden="true">
    <button id="lb-close" aria-label="Close">&times;</button>
    <button id="lb-prev" aria-label="Previous">&#8592;</button>
    <button id="lb-next" aria-label="Next">&#8594;</button>
    <img id="lb-img" src="" alt="" />
  </div>

</Base>

<style>
  .masonry {
    columns: 2;
    column-gap: 3px;
  }
  @media (min-width: 640px)  { .masonry { columns: 3; } }
  @media (min-width: 1024px) { .masonry { columns: 4; } }
  @media (min-width: 1400px) { .masonry { columns: 5; } }

  .masonry-item {
    break-inside: avoid;
    margin-bottom: 3px;
    overflow: hidden;
  }

  .gallery-img {
    display: block;
    width: 100%;
    cursor: zoom-in;
    transition: opacity 0.25s;
  }
  .gallery-img:hover { opacity: 0.88; }

  /* ─── Lightbox ─── */
  #lightbox {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 9000;
    background: rgba(0,0,0,0.94);
    align-items: center;
    justify-content: center;
  }
  #lightbox.open {
    display: flex;
  }
  #lb-img {
    max-width: 92vw;
    max-height: 92vh;
    object-fit: contain;
    border-radius: 2px;
    box-shadow: 0 8px 60px rgba(0,0,0,0.6);
    user-select: none;
  }
  #lb-close {
    position: fixed;
    top: 1.25rem;
    right: 1.5rem;
    font-size: 2rem;
    line-height: 1;
    color: rgba(255,255,255,0.7);
    background: none;
    border: none;
    cursor: pointer;
    transition: color 0.15s;
    z-index: 9001;
  }
  #lb-close:hover { color: #fff; }
  #lb-prev, #lb-next {
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    font-size: 2rem;
    color: rgba(255,255,255,0.55);
    background: none;
    border: none;
    cursor: pointer;
    padding: 1rem;
    transition: color 0.15s;
    z-index: 9001;
    user-select: none;
  }
  #lb-prev { left: 0.5rem; }
  #lb-next { right: 0.5rem; }
  #lb-prev:hover, #lb-next:hover { color: #fff; }
</style>

<script>
  const imgs    = Array.from(document.querySelectorAll<HTMLImageElement>('.gallery-img'));
  const lb      = document.getElementById('lightbox')!;
  const lbImg   = document.getElementById('lb-img') as HTMLImageElement;
  const btnClose = document.getElementById('lb-close')!;
  const btnPrev  = document.getElementById('lb-prev')!;
  const btnNext  = document.getElementById('lb-next')!;
  let current = 0;

  function open(i: number) {
    current = i;
    lbImg.src = imgs[i].dataset.src || imgs[i].src;
    lb.classList.add('open');
    lb.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function close() {
    lb.classList.remove('open');
    lb.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  function navigate(dir: number) {
    current = (current + dir + imgs.length) % imgs.length;
    lbImg.src = imgs[current].dataset.src || imgs[current].src;
  }

  imgs.forEach((img, i) => img.addEventListener('click', () => open(i)));
  btnClose.addEventListener('click', close);
  btnPrev.addEventListener('click', () => navigate(-1));
  btnNext.addEventListener('click', () => navigate(1));
  lb.addEventListener('click', (e) => { if (e.target === lb) close(); });

  document.addEventListener('keydown', (e) => {
    if (!lb.classList.contains('open')) return;
    if (e.key === 'Escape')      close();
    if (e.key === 'ArrowLeft')   navigate(-1);
    if (e.key === 'ArrowRight')  navigate(1);
  });
</script>
