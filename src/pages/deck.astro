<script>
  const slides  = document.querySelectorAll('.slide');
  const dots    = document.querySelectorAll('.nav-dots a');
  const navEl   = document.getElementById('navdots');
  const bar     = document.getElementById('progress-bar');
  const total   = slides.length;
  const darkSet = new Set(['s2', 's4', 's5', 's6', 's7', 's9']);

  const io = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (!entry.isIntersecting) return;
      entry.target.classList.add('is-visible');
      const id = entry.target.id;
      dots.forEach(d => d.classList.remove('active'));
      const dot = document.querySelector(`.nav-dots a[href="#${id}"]`);
      if (dot) dot.classList.add('active');
      navEl.classList.toggle('on-dark', darkSet.has(id));
      const idx = [...slides].indexOf(entry.target);
      bar.style.width = `${((idx + 1) / total) * 100}%`;
    });
  }, { threshold: 0.5 });

  slides.forEach(s => io.observe(s));

  requestAnimationFrame(() => requestAnimationFrame(() => {
    document.getElementById('s1').classList.add('is-visible');
  }));
</script>
