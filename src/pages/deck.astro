  // ── Language logic ────────────────────────────────────────────────────────
  const btn  = document.getElementById('lang-toggle');
  const ltEs = document.getElementById('lt-es');
  const ltEn = document.getElementById('lt-en');

  function applyLang(lang) {
    const dict = T[lang] || T.en;
    document.querySelectorAll('[data-t]').forEach(el => {
      const key = el.getAttribute('data-t');
      if (dict[key] !== undefined) el.innerHTML = dict[key];
    });
    document.documentElement.lang = lang;
    ltEs.classList.toggle('dim', lang !== 'es');
    ltEn.classList.toggle('dim', lang !== 'en');
    try { localStorage.setItem('lamina-lang', lang); } catch(e) {}
  }

  let currentLang = 'en';
  try {
    const saved = localStorage.getItem('lamina-lang');
    if (saved === 'es' || saved === 'en') currentLang = saved;
  } catch(e) {}

  applyLang(currentLang);

  btn.addEventListener('click', () => {
    currentLang = currentLang === 'en' ? 'es' : 'en';
    applyLang(currentLang);
  });
</script>
