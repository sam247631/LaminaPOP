<script>
  // ── Slide state ───────────────────────────────────────────────────────────
  const slides  = Array.from(document.querySelectorAll('.slide'));
  const dots    = document.querySelectorAll('.nav-dots a');
  const navEl   = document.getElementById('navdots');
  const bar     = document.getElementById('progress-bar');
  const total   = slides.length;
  const darkSet  = new Set(['s2', 's5', 's6', 's7', 's8', 's10']);
  const lightSet = new Set(['s1', 's3', 's4', 's9']);
  let currentSlideIdx = 0;

  const io = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (!entry.isIntersecting) return;
      entry.target.classList.add('is-visible');
      const id = entry.target.id;
      dots.forEach(d => d.classList.remove('active'));
      const dot = document.querySelector(`.nav-dots a[href="#${id}"]`);
      if (dot) dot.classList.add('active');
      navEl.classList.toggle('on-dark', darkSet.has(id));
      document.body.classList.toggle('on-light', lightSet.has(id));
      currentSlideIdx = slides.indexOf(entry.target);
      bar.style.width = `${((currentSlideIdx + 1) / total) * 100}%`;
    });
  }, { threshold: 0.5 });

  slides.forEach(s => io.observe(s));

  requestAnimationFrame(() => requestAnimationFrame(() => {
    const s1 = document.getElementById('s1');
    if (s1) {
      s1.classList.add('is-visible');
      document.body.classList.add('on-light');
    }
  }));

  // ── Navigate between slides ───────────────────────────────────────────────
  function navigateSlide(dir) {
    const nextIdx = Math.max(0, Math.min(slides.length - 1, currentSlideIdx + dir));
    slides[nextIdx].scrollIntoView({ behavior: 'smooth' });
  }

  // ── Keyboard navigation ───────────────────────────────────────────────────
  document.addEventListener('keydown', e => {
    if (['ArrowDown', 'ArrowRight', 'PageDown'].includes(e.key)) {
      e.preventDefault();
      navigateSlide(1);
    } else if (['ArrowUp', 'ArrowLeft', 'PageUp'].includes(e.key)) {
      e.preventDefault();
      navigateSlide(-1);
    }
  });

  // ── Touch swipe navigation ────────────────────────────────────────────────
  let touchStartY = 0;
  let touchStartX = 0;
  document.addEventListener('touchstart', e => {
    touchStartY = e.touches[0].clientY;
    touchStartX = e.touches[0].clientX;
  }, { passive: true });
  document.addEventListener('touchend', e => {
    const dy = touchStartY - e.changedTouches[0].clientY;
    const dx = touchStartX - e.changedTouches[0].clientX;
    if (Math.abs(dy) < 50 && Math.abs(dx) < 50) return;
    if (Math.abs(dy) >= Math.abs(dx)) {
      navigateSlide(dy > 0 ? 1 : -1);
    }
  }, { passive: true });

  // ── PDF download ──────────────────────────────────────────────────────────
  document.getElementById('pdf-btn').addEventListener('click', () => window.print());

