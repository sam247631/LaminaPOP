---
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Lamina POP — Investor Deck</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" />
</head>
<body>

  <div id="progress-bar"></div>

  <!-- Language toggle -->
  <button id="lang-toggle" type="button" aria-label="Cambiar idioma / Change language">
    <span id="lt-es">ES</span>
    <span class="lt-sep">/</span>
    <span id="lt-en">EN</span>
  </button>

  <!-- PDF download -->
  <button id="pdf-btn" type="button" aria-label="Download as PDF">
    <svg width="13" height="13" viewBox="0 0 13 13" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M6.5 1v7M6.5 8l-2.5-2.5M6.5 8l2.5-2.5M1 10.5h11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    PDF
  </button>

  <nav class="nav-dots" id="navdots" aria-label="Slide navigation">
    <a href="#s1"  title="The Thesis"></a>
    <a href="#s2"  title="The Problem"></a>
    <a href="#s3"  title="Technology"></a>
    <a href="#s4"  title="Competitive Advantage"></a>
    <a href="#s5"  title="Speed & Scale"></a>
    <a href="#s6"  title="Human Impact"></a>
    <a href="#s7"  title="Traction"></a>
    <a href="#s8"  title="Business Model"></a>
    <a href="#s9"  title="The Ask"></a>
    <a href="#s10" title="Contact"></a>
  </nav>

  <!-- ── S1: The Thesis ── -->
  <section class="slide s-pop" id="s1">
    <div class="inner s1-grid">
      <div>
        <h1 class="s1-title" data-a>LAMINA<br>POP</h1>
      </div>
      <div class="s1-right">
        <p class="eyebrow" data-a style="--d:0.15s" data-t="s1-eyebrow">01 — The Thesis</p>
        <p class="s1-tagline" data-a style="--d:0.3s" data-t="s1-tagline">Redefining Structural Infrastructure<br>for Emerging Markets.</p>
        <p class="s1-meta" data-a style="--d:0.45s" data-t="s1-meta">Investor Deck · 2026</p>
      </div>
    </div>
    <span class="slide-num">01 / 10</span>
  </section>

  <!-- ── S2: The Core Problem ── -->
  <section class="slide s-dark" id="s2">
    <div class="inner">
      <p class="eyebrow eyebrow-light" data-a data-t="s2-eyebrow">02 — The Core Problem</p>
      <h2 data-a style="--d:0.12s" data-t="s2-h2">The Shelter<br>and Debt Trap</h2>
      <p class="lead lead-muted" data-a style="--d:0.24s" data-t="s2-lead">In emerging markets, families are forced to choose between two unsustainable paths:</p>
      <div class="two-col" data-a style="--d:0.38s">
        <div class="prob-card">
          <div class="prob-num">01</div>
          <h3 class="prob-title" data-t="s2-p1-title">Hazardous Shelter</h3>
          <p data-t="s2-p1-desc">Living in substandard dirt-floor structures that cause chronic illness and trap families in cycles of poor health.</p>
        </div>
        <div class="prob-card">
          <div class="prob-num">02</div>
          <h3 class="prob-title" data-t="s2-p2-title">Debt Trap</h3>
          <p data-t="s2-p2-desc">Taking on exploitative microfinance loans with crushing 30%+ compounding interest to build traditional concrete masonry.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── S3: Technology Solution ── -->
  <section class="slide s-paper" id="s3">
    <div class="inner">
      <p class="eyebrow" data-a data-t="s3-eyebrow">03 — The Technology Solution</p>
      <h2 data-a style="--d:0.12s" data-t="s3-h2">Waveform<br>Geometry</h2>
      <div class="tech-grid">
        <div class="tech-left">
          <p class="lead" data-a style="--d:0.22s" data-t="s3-lead">A patented architectural technology that turns lightweight, globally accessible sheet metal into strong, load-bearing structures.</p>
          <ul class="feat-list" data-a style="--d:0.34s">
            <li>
              <span class="feat-title" data-t="s3-f1-title">3-in-1 Envelope</span>
              <span class="feat-desc" data-t="s3-f1-desc">Parallel galvanized steel sheets are vertically riveted to serve as wall, roof, and frame simultaneously.</span>
            </li>
            <li>
              <span class="feat-title" data-t="s3-f2-title">Zero Lumber or Masonry</span>
              <span class="feat-desc" data-t="s3-f2-desc">Eliminates the need for traditional structural wood or concrete block infrastructure.</span>
            </li>
            <li>
              <span class="feat-title" data-t="s3-f3-title">Built for Extremes</span>
              <span class="feat-desc" data-t="s3-f3-desc">Seismically flexible and wind-resistant. Standing for over 15 years in tropical, earthquake-prone regions with zero structural failures.</span>
            </li>
          </ul>
        </div>
        <div data-a style="--d:0.46s">
          <img src="/deck/laminas.png" alt="Lamina POP waveform steel sheets" class="tech-img" />
        </div>
      </div>
    </div>
  </section>

  <!-- ── S4: Competitive Advantage (comparison table) ── -->
  <section class="slide s-paper" id="s4">
    <div class="inner">
      <p class="eyebrow" data-a data-t="s4c-eyebrow">04 — The Competitive Advantage</p>
      <h2 data-a style="--d:0.12s" data-t="s4c-h2">Two Materials.<br>Every Advantage.</h2>
      <div class="comp-wrap" data-a style="--d:0.28s">
        <div class="comp-table">
          <!-- Header row -->
          <div class="comp-row comp-header-row">
            <div class="comp-cell comp-row-label"></div>
            <div class="comp-cell comp-col-us">Lamina POP</div>
            <div class="comp-cell comp-col-other" data-t="s4c-h-mas">Masonry</div>
            <div class="comp-cell comp-col-other" data-t="s4c-h-tim">Timber</div>
          </div>
          <!-- Row 1 -->
          <div class="comp-row">
            <div class="comp-cell comp-row-label" data-t="s4c-r1">Cost per m²</div>
            <div class="comp-cell comp-col-us comp-win">$150–200</div>
            <div class="comp-cell comp-col-other comp-neutral">$400–600</div>
            <div class="comp-cell comp-col-other comp-neutral">$280–400</div>
          </div>
          <!-- Row 2 -->
          <div class="comp-row">
            <div class="comp-cell comp-row-label" data-t="s4c-r2">Build time</div>
            <div class="comp-cell comp-col-us comp-win" data-t="s4c-v2">7–14 days</div>
            <div class="comp-cell comp-col-other comp-neutral" data-t="s4c-m2">4–8 weeks</div>
            <div class="comp-cell comp-col-other comp-neutral" data-t="s4c-t2">3–6 weeks</div>
          </div>
          <!-- Row 3 -->
          <div class="comp-row">
            <div class="comp-cell comp-row-label" data-t="s4c-r3">Skilled labour</div>
            <div class="comp-cell comp-col-us comp-win" data-t="s4c-v3">Not required</div>
            <div class="comp-cell comp-col-other comp-neutral" data-t="s4c-m3">Required</div>
            <div class="comp-cell comp-col-other comp-neutral" data-t="s4c-t3">Required</div>
          </div>
          <!-- Row 4 -->
          <div class="comp-row">
            <div class="comp-cell comp-row-label" data-t="s4c-r4">Seismic resistance</div>
            <div class="comp-cell comp-col-us comp-win" data-t="s4c-v4">High</div>
            <div class="comp-cell comp-col-other comp-neutral" data-t="s4c-m4">Low</div>
            <div class="comp-cell comp-col-other comp-neutral" data-t="s4c-t4">Medium</div>
          </div>
          <!-- Row 5 -->
          <div class="comp-row">
            <div class="comp-cell comp-row-label" data-t="s4c-r5">Logistics</div>
            <div class="comp-cell comp-col-us comp-win" data-t="s4c-v5">Flat-pack</div>
            <div class="comp-cell comp-col-other comp-neutral" data-t="s4c-m5">Heavy trucks</div>
            <div class="comp-cell comp-col-other comp-neutral" data-t="s4c-t5">Bulky</div>
          </div>
          <!-- Row 6 -->
          <div class="comp-row comp-last-row">
            <div class="comp-cell comp-row-label" data-t="s4c-r6">Longevity</div>
            <div class="comp-cell comp-col-us comp-win" data-t="s4c-v6">15+ years</div>
            <div class="comp-cell comp-col-other comp-neutral" data-t="s4c-m6">Standard</div>
            <div class="comp-cell comp-col-other comp-neutral" data-t="s4c-t6">Standard</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── S5: Speed and Scale ── -->
  <section class="slide s-img" id="s5">
    <img src="/deck/speed.jpg" alt="Lamina POP construction team" class="slide-bg" />
    <div class="slide-overlay"></div>
    <div class="inner">
      <p class="eyebrow" data-a data-t="s5-eyebrow">05 — Speed and Scale</p>
      <h2 data-a style="--d:0.12s" data-t="s5-h2">7 to 14<br>Days</h2>
      <p class="lead" data-a style="--d:0.22s" data-t="s5-lead">The time it takes a 3-person team using basic hand tools to assemble a complete, flat-packed Lamina POP home.</p>
      <div class="speed-row" data-a style="--d:0.34s">
        <div class="speed-stat">
          <div class="speed-label" data-t="s5-sl1">Logistics</div>
          <div class="speed-val" data-t="s5-sv1">Resilient</div>
          <p data-t="s5-sp1">Flat-pack shipping for remote, low-infrastructure areas where concrete trucks cannot pass.</p>
        </div>
        <div class="speed-stat">
          <div class="speed-label" data-t="s5-sl2">Cost Per Unit</div>
          <div class="speed-val">$4,200–<br>$5,000</div>
          <p data-t="s5-sp2">Roughly half the price of regional masonry alternatives.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── S6: Human Impact ── -->
  <section class="slide s-img" id="s6">
    <img src="/deck/impact.jpg" alt="Lamina POP family home" class="slide-bg" />
    <div class="slide-overlay s6-overlay"></div>
    <div class="inner">
      <p class="eyebrow" data-a data-t="s6-eyebrow">06 — The Human Impact</p>
      <h2 data-a style="--d:0.12s" data-t="s6-h2">The Structural<br>Surplus</h2>
      <p class="lead" data-a style="--d:0.22s" data-t="s6-lead">Moving a family out of substandard shelter into a Lamina POP home immediately transforms their household economics:</p>
      <div class="impact-row" data-a style="--d:0.34s">
        <div class="impact-stat">
          <div class="impact-val">−44%</div>
          <div class="impact-desc" data-t="s6-id1">Reduction in school and work absenteeism</div>
        </div>
        <div class="impact-divider"></div>
        <div class="impact-stat">
          <div class="impact-val">+17%</div>
          <div class="impact-desc" data-t="s6-id2">Structural increase in available household financial capital by permanently cutting emergency medical expenses</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── S7: Market Traction ── -->
  <section class="slide s-img" id="s7">
    <img src="/deck/traction.jpg" alt="Lamina POP project community" class="slide-bg" />
    <div class="slide-overlay"></div>
    <div class="inner">
      <p class="eyebrow" data-a data-t="s7-eyebrow">07 — Market Traction</p>
      <h2 data-a style="--d:0.12s" data-t="s7-h2">Proven<br>Validation</h2>
      <div class="traction-grid" data-a style="--d:0.26s">
        <div class="traction-card">
          <div class="traction-val">15+</div>
          <div class="traction-key" data-t="s7-tk1">Permanent Structures Built</div>
          <p data-t="s7-tp1">Homes, warehouses, and institutional schools standing across Central America.</p>
        </div>
        <div class="traction-card">
          <div class="traction-val">$75K</div>
          <div class="traction-key" data-t="s7-tk2">LTM Revenue</div>
          <p data-t="s7-tp2">Achieved during our lean, capital-efficient, high-margin pilot R&D phase.</p>
        </div>
        <div class="traction-card">
          <div class="traction-val">✓</div>
          <div class="traction-key" data-t="s7-tk3">Habitat for Humanity</div>
          <p data-t="s7-tp3">Active deployment pipelines in partnership with one of the world's leading housing NGOs.</p>
        </div>
        <div class="traction-card">
          <div class="traction-val">3×</div>
          <div class="traction-key" data-t="s7-tk4">Global Recognition</div>
          <p data-t="s7-tp4">Backed by SantanderX, the Autodesk Foundation, and incubated at Cambridge Judge Business School.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── S8: Commercial Engine ── -->
  <section class="slide s-dark" id="s8">
    <div class="inner">
      <p class="eyebrow eyebrow-light" data-a data-t="s8-eyebrow">08 — The Commercial Engine</p>
      <h2 data-a style="--d:0.12s" data-t="s8-h2">The Hybrid<br>Business Model</h2>
      <p class="lead lead-muted" data-a style="--d:0.22s" data-t="s8-lead">We balance three distinct customer streams to maintain a self-sustaining enterprise:</p>
      <div class="model-grid" data-a style="--d:0.36s">
        <div class="model-card">
          <div class="model-tag" data-t="s8-mt1">B2B Commercial</div>
          <p data-t="s8-mp1">High-design cabins and utility structures for eco-resorts and industrial clients at full market rate, generating a ~20% margin.</p>
        </div>
        <div class="model-card">
          <div class="model-tag" data-t="s8-mt2">Mid-Market Direct</div>
          <p data-t="s8-mp2">Affordable housing solutions for private lower-middle-income buyers seeking an accessible path to dignified shelter.</p>
        </div>
        <div class="model-card">
          <div class="model-tag" data-t="s8-mt3">Institutional Tenders</div>
          <p data-t="s8-mp3">Bulk, high-volume social housing infrastructure alongside corporate CSR programs and municipal budgets.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── S9: The Ask ── -->
  <section class="slide s-pop" id="s9">
    <div class="inner">
      <p class="eyebrow" data-a data-t="s9-eyebrow">09 — The Ask & Use of Funds</p>
      <h2 class="ink" data-a style="--d:0.12s" data-t="s9-h2">Scaling<br>Manufacturing</h2>
      <p class="lead ink-muted" data-a style="--d:0.22s" data-t="s9-lead">We are raising strategic capital to transition from our proven pilot phase into a centralized prefabrication facility.</p>
      <div class="ask-grid" data-a style="--d:0.36s">
        <div class="ask-card">
          <div class="ask-pct">40%</div>
          <div class="ask-label" data-t="s9-al1">Factory Optimization</div>
          <p data-t="s9-ap1">Upgrading tooling to cut on-site assembly time from 14 days down to 7 days.</p>
        </div>
        <div class="ask-card">
          <div class="ask-pct">30%</div>
          <div class="ask-label" data-t="s9-al2">Direct Bulk Procurement</div>
          <p data-t="s9-ap2">Securing steel directly from mills to reduce per-unit costs by 12–18%.</p>
        </div>
        <div class="ask-card">
          <div class="ask-pct">20%</div>
          <div class="ask-label" data-t="s9-al3">Key Operational Team</div>
          <p data-t="s9-ap3">Expanding full-time local management, data governance, and manufacturing logistics staff.</p>
        </div>
        <div class="ask-card">
          <div class="ask-pct">10%</div>
          <div class="ask-label" data-t="s9-al4">Institutional Certifications</div>
          <p data-t="s9-ap4">Finalizing approved status with national public housing subsidy frameworks.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── S10: Contact ── -->
  <section class="slide s-dark" id="s10">
    <div class="inner">
      <p class="eyebrow eyebrow-light" data-a data-t="s10-eyebrow">10 — Contact</p>
      <h2 class="closing-h2" data-a style="--d:0.12s" data-t="s10-h2">Build the Future<br>With <em class="pop-em">Us.</em></h2>
      <p class="calc-callout" data-a style="--d:0.22s" data-t="s10-calc">Try our free <a href="https://www.laminapop.com/calculator" class="calc-link">construction cost calculator</a> — designed to put the system in anyone's hands, anywhere in the world.</p>
      <div class="contact-block" data-a style="--d:0.38s">
        <div class="contact-row">
          <span class="c-label">CEO</span>
          <span class="c-val">Sebastian Swezey</span>
        </div>
        <div class="contact-row">
          <span class="c-label">Email</span>
          <a href="mailto:swezey47@gmail.com" class="c-link">swezey47@gmail.com</a>
        </div>
        <div class="contact-row">
          <span class="c-label">Web</span>
          <a href="https://www.laminapop.com" class="c-link">www.laminapop.com</a>
        </div>
      </div>
      <p class="c-copy" data-a style="--d:0.5s">© 2004–2026 Lamina POP</p>
    </div>
  </section>

</body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --ink:   #0A0A0A;
    --paper: #FFFFFF;
    --pop:   #FFD600;
    --muted: #6B6B6B;
    --line:  #E5E5E5;
  }

  html {
    scroll-behavior: smooth;
    scroll-snap-type: y mandatory;
    overflow-y: scroll;
    height: 100%;
  }

  body {
    font-family: Inter, sans-serif;
    background: var(--ink);
    color: var(--ink);
    line-height: 1.55;
    height: 100%;
  }

  /* ── progress bar ── */
  #progress-bar {
    position: fixed;
    top: 0; left: 0;
    height: 3px;
    background: var(--pop);
    width: 0;
    transition: width 0.5s ease;
    z-index: 200;
  }

  /* ── UI buttons (lang toggle + PDF) ── */
  #lang-toggle,
  #pdf-btn {
    position: fixed;
    top: 1.25rem;
    z-index: 150;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    background: rgba(255,255,255,0.12);
    border: 1px solid rgba(255,255,255,0.18);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-radius: 100px;
    padding: 0.4rem 0.85rem;
    font-family: Inter, sans-serif;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.9);
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s;
  }
  #lang-toggle:hover,
  #pdf-btn:hover {
    background: rgba(255,255,255,0.2);
    border-color: rgba(255,255,255,0.35);
  }
  #lang-toggle { left: 1.5rem; }
  #pdf-btn     { left: 6.5rem; }

  #lang-toggle .lt-sep { opacity: 0.35; }
  #lt-es, #lt-en { transition: opacity 0.2s; }
  #lt-es.dim, #lt-en.dim { opacity: 0.3; }

  /* adapt both buttons on light slides */
  body.on-light #lang-toggle,
  body.on-light #pdf-btn {
    background: rgba(0,0,0,0.08);
    border-color: rgba(0,0,0,0.15);
    color: rgba(0,0,0,0.8);
  }
  body.on-light #lang-toggle:hover,
  body.on-light #pdf-btn:hover {
    background: rgba(0,0,0,0.14);
    border-color: rgba(0,0,0,0.28);
  }

  /* ── nav dots ── */
  .nav-dots {
    position: fixed;
    right: 1.5rem;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    z-index: 100;
  }
  .nav-dots a {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgba(0,0,0,0.22);
    display: block;
    transition: background 0.25s, transform 0.25s;
  }
  .nav-dots a.active,
  .nav-dots a:hover {
    background: var(--ink);
    transform: scale(1.6);
  }
  .nav-dots.on-dark a { background: rgba(255,255,255,0.28); }
  .nav-dots.on-dark a.active,
  .nav-dots.on-dark a:hover {
    background: var(--pop);
    transform: scale(1.6);
  }

  /* ── slide base ── */
  .slide {
    scroll-snap-align: start;
    min-height: 100svh;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 5rem 2rem;
    position: relative;
  }
  .s-pop   { background: var(--pop); }
  .s-dark  { background: var(--ink); color: var(--paper); }
  .s-paper { background: var(--paper); }

  .inner {
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
  }

  /* ── type ── */
  .eyebrow {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1.5rem;
  }
  .eyebrow-light { color: rgba(255,255,255,0.38); }

  h2 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.03em;
    margin-bottom: 2rem;
    color: inherit;
  }
  .s-dark h2 { color: var(--paper); }

  .lead {
    font-size: 1.125rem;
    color: var(--muted);
    max-width: 640px;
    margin-bottom: 3rem;
    line-height: 1.65;
  }
  .lead-muted { color: rgba(255,255,255,0.48); }
  .ink-muted  { color: rgba(10,10,10,0.5); }
  .ink        { color: var(--ink); }

  /* ── entrance animations ── */
  [data-a] {
    opacity: 0;
    transform: translateY(26px);
    transition: opacity 0.65s ease, transform 0.65s ease;
    transition-delay: var(--d, 0s);
  }
  .is-visible [data-a] {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── S1: Cover ── */
  .s1-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
