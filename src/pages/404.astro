---
import Base from '../layouts/Base.astro';

// BrandLogo geometry — matches BrandLogo.astro exactly
const LX = 58, RX = 442;
const TY = 90, BY = 412;
const CYCLES = 5, AMP = 36;
const SW = 12;

function waveR(baseY: number, x0: number, x1: number, cycles: number, amp: number) {
  const W = (x1 - x0) / cycles;
  const k = (4 / 3) * amp;
  const f = (n: number) => +n.toFixed(1);
  let d = `M${x0},${baseY}`;
  for (let i = 0; i < cycles; i++) {
    const x = x0 + i * W;
    d += ` C${f(x+W/6)},${f(baseY-k)} ${f(x+W/3)},${f(baseY-k)} ${f(x+W/2)},${baseY}`;
    d += ` C${f(x+2*W/3)},${f(baseY+k)} ${f(x+5*W/6)},${f(baseY+k)} ${f(x+W)},${baseY}`;
  }
  return d;
}

function waveL(baseY: number, x0: number, x1: number, cycles: number, amp: number) {
  const W = (x0 - x1) / cycles;
  const k = (4 / 3) * amp;
  const f = (n: number) => +n.toFixed(1);
  let d = '';
  for (let i = 0; i < cycles; i++) {
    const x = x0 - i * W;
    d += ` C${f(x-W/6)},${f(baseY+k)} ${f(x-W/3)},${f(baseY+k)} ${f(x-W/2)},${baseY}`;
    d += ` C${f(x-2*W/3)},${f(baseY-k)} ${f(x-5*W/6)},${f(baseY-k)} ${f(x-W)},${baseY}`;
  }
  return d;
}

const shapePath = waveR(TY, LX, RX, CYCLES, AMP)
  + ` L${RX},${BY}`
  + waveL(BY, RX, LX, CYCLES, AMP)
  + ' Z';

const CX = 188, CY = 218, CR = 60;
const DL = 283, DR = 363, DT = 248;
const doorPath = `M${DL},${BY} L${DL},${DT} L${DR},${DT} L${DR},${BY}`;
---

<Base title="404 — Lamina POP">
  <div class="page">

    <svg class="logo-svg" viewBox="0 0 500 500" xmlns="http://www.w3.org/2000/svg" fill="none" aria-hidden="true">

      <!-- Outer corrugated shape — stroke only, drawn first -->
      <path
        id="anim-shape"
        d={shapePath}
        fill="none"
        stroke="#0A0A0A"
        stroke-width={SW}
        stroke-linejoin="round"
        stroke-linecap="round"
      />

      <!-- Circle / porthole -->
      <circle
        id="anim-circle"
        cx={CX} cy={CY} r={CR}
        fill="none"
        stroke="#0A0A0A"
        stroke-width={SW}
      />

      <!-- Door -->
      <path
        id="anim-door"
        d={doorPath}
        fill="none"
        stroke="#0A0A0A"
        stroke-width={SW}
        stroke-linecap="square"
        stroke-linejoin="miter"
      />
    </svg>

    <p class="eyebrow">404</p>
    <h1 class="headline">This page hasn't<br>been built yet.</h1>
    <p class="sub">
      Give us 72 hours — we'll rivet something together.<br>
      In the meantime, check out what we <em>have</em> built already.
    </p>
    <div class="cta-row">
      <a href="/" class="cta-primary">See the system →</a>
      <a href="/gallery" class="cta-secondary">View gallery</a>
    </div>
  </div>
</Base>

<style>
  .page {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 3rem 1.5rem 4rem;
  }

  .logo-svg {
    width: min(300px, 70vw);
    height: auto;
    margin-bottom: 2.5rem;
  }

  /* Start hidden — JS sets dasharray/offset after measuring real path length */
  #anim-shape, #anim-circle, #anim-door { opacity: 0; }

  @keyframes drawIn {
    to { stroke-dashoffset: 0; opacity: 1; }
  }

  /* ─── Text ─── */
  .eyebrow {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #6B6B6B;
    margin-bottom: 1rem;
    opacity: 0;
    animation: fadeUp 0.4s 2.2s ease-out forwards;
  }
  .headline {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: clamp(2.2rem, 7vw, 5rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
    color: #0A0A0A;
    margin-bottom: 1.5rem;
    opacity: 0;
    animation: fadeUp 0.45s 2.4s ease-out forwards;
  }
  .sub {
    font-size: clamp(0.88rem, 2vw, 1.05rem);
    color: #6B6B6B;
    line-height: 1.7;
    max-width: 36ch;
    margin-bottom: 2.5rem;
    opacity: 0;
    animation: fadeUp 0.4s 2.6s ease-out forwards;
  }
  .sub em { color: #0A0A0A; font-style: normal; font-weight: 600; }
  .cta-row {
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
    justify-content: center;
    opacity: 0;
    animation: fadeUp 0.4s 2.8s ease-out forwards;
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(6px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ─── CTAs ─── */
  .cta-primary {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: #0A0A0A;
    border-bottom: 2.5px solid #FFD600;
    padding-bottom: 2px;
    transition: opacity 0.2s;
  }
  .cta-primary:hover { opacity: 0.55; }
  .cta-secondary {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: #6B6B6B;
    transition: color 0.2s;
  }
  .cta-secondary:hover { color: #0A0A0A; }
</style>

<script is:inline>
  // Measure real path lengths then kick off the stroke-draw animation
  window.addEventListener('DOMContentLoaded', function () {
    var shape  = document.getElementById('anim-shape');
    var circle = document.getElementById('anim-circle');
    var door   = document.getElementById('anim-door');

    function animatePath(el, delay, duration) {
      var len = el.getTotalLength ? el.getTotalLength() : 2000;
      el.style.strokeDasharray  = len;
      el.style.strokeDashoffset = len;
      el.style.opacity = '1';
      el.style.animation = 'drawIn ' + duration + 's ' + delay + 's ease-in-out forwards';
    }

    animatePath(shape,  0.1, 1.4);
    animatePath(circle, 1.3, 0.6);
    animatePath(door,   1.8, 0.5);
  });
</script>
