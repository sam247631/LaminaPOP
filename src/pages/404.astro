---
import Base from '../layouts/Base.astro';
---

<Base title="404 — Lamina POP">
  <div class="page">

    <img src="/logo-404.png" alt="Lamina POP" class="logo-img" />

    <p class="eyebrow">404</p>
    <h1 class="headline">This page hasn't<br>been built yet.</h1>
    <p class="sub">
      Give us 72 hours — we'll rivet something together.<br>
      In the meantime, check out what we <em>have</em> built already.
    </p>
    <div class="cta-row">
      <a href="/" class="cta-primary">See the system →</a>
      <a href="/gallery" class="cta-secondary">View gallery</a>
    </div>

  </div>
</Base>

<style>
  .page {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 3rem 1.5rem 4rem;
  }

  .logo-img {
    width: min(260px, 60vw);
    height: auto;
    margin-bottom: 2.5rem;
  }

  .eyebrow {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #6B6B6B;
    margin-bottom: 1rem;
  }
  .headline {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: clamp(2.2rem, 7vw, 5rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
    color: #0A0A0A;
    margin-bottom: 1.5rem;
  }
  .sub {
    font-size: clamp(0.88rem, 2vw, 1.05rem);
    color: #6B6B6B;
    line-height: 1.7;
    max-width: 36ch;
    margin-bottom: 2.5rem;
  }
  .sub em { color: #0A0A0A; font-style: normal; font-weight: 600; }

  .cta-row {
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .cta-primary {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: #0A0A0A;
    border-bottom: 2.5px solid #FFD600;
    padding-bottom: 2px;
    transition: opacity 0.2s;
  }
  .cta-primary:hover { opacity: 0.55; }
  .cta-secondary {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: #6B6B6B;
    transition: color 0.2s;
  }
  .cta-secondary:hover { color: #0A0A0A; }
</style>
