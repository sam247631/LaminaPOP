      Complete · 18 / 18
    </p>
    <h2 id="fin-title" class="fin-el font-['Space_Grotesk'] text-[clamp(3.5rem,10vw,9rem)] font-bold leading-[0.88] tracking-[-0.04em] text-[#0A0A0A]">
      Your home<br>is ready.
    </h2>
    <p class="fin-el mt-8 max-w-xs text-base font-semibold text-[#0A0A0A]/50">
      72 hours. Two materials.<br>Zero skilled labour.
    </p>
    <a
      href="/"
      class="fin-el mt-12 inline-flex items-center gap-2 border-b-2 border-[#0A0A0A]/20 pb-1 text-[11px] font-bold uppercase tracking-[0.18em] text-[#0A0A0A]/50 transition-all hover:border-[#0A0A0A] hover:text-[#0A0A0A]"
    >
      Learn more about Lamina POP →
    </a>
  </section>

</Base>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  // ── Progress bar ─────────────────────────────────────────────
  const progressBar = document.getElementById('g-progress')!;
  ScrollTrigger.create({
    start: 0,
    end: 'max',
    onUpdate: (self) => {
      progressBar.style.width = `${self.progress * 100}%`;
    },
  });

  // ── Cover entrance ────────────────────────────────────────────
  gsap.timeline({ defaults: { ease: 'expo.out' } })
    .from('#cov-eye',    { y: 14,  opacity: 0, duration: 0.7 }, 0.05)
    .from('#cov-title',  { y: 50,  opacity: 0, duration: 1.1 }, 0.1)
    .from('#cov-meta',   { y: 24,  opacity: 0, duration: 0.8 }, 0.38)
    .from('#cov-count',  { y: 14,  opacity: 0, duration: 0.7 }, 0.52)
    .from('#cov-scroll', { opacity: 0, duration: 0.5 }, 0.88);

  gsap.to('#cov-scroll', {
    opacity: 0,
    scrollTrigger: {
      trigger: '#g-cover',
      start: 'center top',
      end: 'bottom top',
      scrub: true,
    },
  });

  // ── Live step counter ─────────────────────────────────────────
  const counterEl  = document.getElementById('g-counter')!;
  const counterNum = document.getElementById('g-counter-num')!;
  document.querySelectorAll<HTMLElement>('.guide-step').forEach((step) => {
    ScrollTrigger.create({
      trigger: step,
      start: 'top 55%',
      onEnter() {
        counterNum.textContent = step.dataset.step!;
        counterEl.classList.remove('hidden');
        counterEl.classList.add('md:block');
      },
      onEnterBack() {
        counterNum.textContent = step.dataset.step!;
      },
    });
  });

  // ── Per-step reveal animations ────────────────────────────────
  document.querySelectorAll<HTMLElement>('.guide-step').forEach((step) => {
    const num     = step.querySelector<HTMLElement>('.step-num')!;
    const bars    = step.querySelectorAll<HTMLElement>('.step-bar');
    const imgWrap = step.querySelector<HTMLElement>('.step-img-wrap')!;
    const img     = step.querySelector<HTMLElement>('.step-img')!;

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: step,
        start: 'top 84%',
        once: true,
      },
    });

    tl.from(num, {
      opacity: 0,
      scale: 1.22,
      y: -8,
      duration: 0.4,
      ease: 'back.out(2)',
    })
    .from(bars, {
      scaleX: 0,
      transformOrigin: 'left center',
      duration: 0.38,
      ease: 'expo.out',
      stagger: 0,
    }, '-=0.05')
    .fromTo(
      imgWrap,
      { clipPath: 'inset(100% 0 0 0)' },
      { clipPath: 'inset(0% 0 0 0)', duration: 0.9, ease: 'power3.out' },
      '-=0.2'
    )
    .from(img, {
      scale: 1.04,
      duration: 0.9,
      ease: 'power3.out',
    }, '<')
    .from(step.querySelector('.step-desc'), {
      opacity: 0,
      y: 10,
      duration: 0.6,
      ease: 'expo.out',
    }, '-=0.4');
  });

  // ── Completion section reveal ─────────────────────────────────
  gsap.from('#g-finish .fin-el', {
    y: 28,
    opacity: 0,
    duration: 0.8,
    ease: 'expo.out',
    stagger: 0.1,
    scrollTrigger: {
      trigger: '#g-finish',
      start: 'top 78%',
      once: true,
    },
  });

  // ── Calculator state bridge ───────────────────────────────────
  try {
    const raw = localStorage.getItem('lamina-guide-state');
    if (raw) {
      const s = JSON.parse(raw);

      // Material quantities
      const sheetEl = document.getElementById('mat-sheet-text');
      if (sheetEl && s.lam) sheetEl.textContent = `${s.lam} sheets (${s.selH}ft)`;

      const rivetEl = document.getElementById('mat-rivet-text');
      if (rivetEl && s.riv) rivetEl.textContent = `${s.riv} POP rivets`;

      const ubItem = document.getElementById('mat-ub-item');
      const ubText = document.getElementById('mat-ub-text');
      if (ubItem && ubText && s.ub) {
        ubText.textContent = `${s.ub} U-blocks`;
        ubItem.classList.remove('hidden');
        ubItem.classList.add('flex');
      }

      // Count line
      const parts: string[] = [];
      if (s.panels) parts.push(`${s.panels} panels`);
      if (s.totWallLen > 0) parts.push(`${s.totWallLen.toFixed(1)}m walls`);
      if (s.area > 0.5) parts.push(`${s.area.toFixed(0)}m² floor`);
      parts.push('72 hours');
      const covCount = document.getElementById('cov-count');
      if (covCount && parts.length) covCount.textContent = parts.join(' · ');

      // Step 12 SVG — panel count badge
      const panelCountEl = document.getElementById('svg-panel-count');
      if (panelCountEl && s.panels) panelCountEl.textContent = `${s.panels}`;

      // Floor plan image in cover
      if (s.img2Durl) {
        const planImg = document.getElementById('g-plan-img') as HTMLImageElement | null;
        const planPreview = document.getElementById('g-plan-preview');
        const planDims = document.getElementById('g-plan-dims');
        if (planImg && planPreview) {
          planImg.src = s.img2Durl;
          planPreview.classList.remove('hidden');
          gsap.from(planPreview, { y: 24, opacity: 0, duration: 0.8, ease: 'expo.out', delay: 0.45 });

          // Also replace step 01 SVG with the floor plan image
          const step01Img = document.querySelector('[data-step="01"] .step-img') as HTMLElement | null;
          if (step01Img) {
            step01Img.innerHTML = `<img src="${s.img2Durl}" alt="Your floor plan" class="w-full object-contain" style="max-height:60vh" />`;
          }
        }
        if (planDims) {
          const dimParts: string[] = [];
          if (s.projectName) dimParts.push(s.projectName);
          if (s.totWallLen > 0) dimParts.push(`${s.totWallLen.toFixed(1)}m perimeter`);
          if (s.area > 0.5) dimParts.push(`${s.area.toFixed(0)} m²`);
          if (s.doorsCount) dimParts.push(`${s.doorsCount} door${s.doorsCount > 1 ? 's' : ''}`);
          if (s.winsCount) dimParts.push(`${s.winsCount} window${s.winsCount > 1 ? 's' : ''}`);
          planDims.textContent = dimParts.join(' · ');
        }
      }

      // Completion section
      const finTitle = document.getElementById('fin-title');
      if (finTitle && s.projectName) {
        finTitle.innerHTML = `${s.projectName}<br><span style="opacity:.5">is ready.</span>`;
      }
    }
  } catch (_) {}
</script>
