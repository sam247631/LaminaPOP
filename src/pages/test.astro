---
import Base from '../layouts/Base.astro';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

// For each step, check if a custom image exists in public/guide/
// Supported extensions in priority order
const EXT = ['png', 'jpg', 'jpeg', 'webp', 'svg'];
function stepImg(n: string): string | null {
  for (const ext of EXT) {
    if (existsSync(join(process.cwd(), 'public', 'guide', `${n}.${ext}`))) {
      return `/guide/${n}.${ext}`;
    }
  }
  return null;
}

const steps = [
  {
    n: '01',
    title: 'Your floor plan',
    desc: 'Begin with a clear layout. Every wall length drives the material list. Use the calculator to generate yours.',
    dynamic: 'plan',
  },
  {
    n: '02',
    title: 'Level the ground',
    desc: 'Clear vegetation and compact the soil. Use a spirit level — a flat base is the foundation of everything.',
  },
  {
    n: '03',
    title: 'Mark the corners',
    desc: 'Drive stakes at each corner of the floor plan. Run string lines between them to define the wall line.',
  },
  {
    n: '04',
    title: 'Pour the footings',
    desc: 'Dig a shallow trench along the string lines and pour a concrete strip footing. Allow 24 h to cure.',
  },
  {
    n: '05',
    title: 'Install floor U-blocks',
    desc: 'Lay the bottom U-channel along the footing perimeter. This channel receives the base of every panel.',
  },
  {
    n: '06',
    title: 'Connect corner channels',
    desc: 'At each corner, mitre or overlap the U-block sections and fasten with two rivets per joint.',
  },
  {
    n: '07',
    title: 'The corrugated panel',
    desc: 'Each panel is one standard corrugated sheet folded into a standing wave. No cutting or welding needed.',
  },
  {
    n: '08',
    title: 'Insert the first panel',
    desc: 'Slide the panel base into the floor U-channel. Hold plumb. The wave geometry keeps it rigid on its own.',
  },
  {
    n: '09',
    title: 'Rivet to the channel',
    desc: 'Drive two POP rivets through the panel foot and the U-block flange — one on each face. Repeat every panel.',
  },
  {
    n: '10',
    title: 'Overlap the next panel',
    desc: 'Each new panel overlaps the previous by one corrugation (≈10 cm). The interlock is structural.',
  },
  {
    n: '11',
    title: 'Rivet the overlap',
    desc: 'Rivet the overlapping crest at mid-height and at the top. This stitches the wall into a single membrane.',
  },
  {
    n: '12',
    title: 'Continue around the perimeter',
    desc: 'Work panel by panel around all four walls. The count matches your material list exactly.',
    dynamic: 'panels',
  },
  {
    n: '13',
    title: 'Cap with top U-block',
    desc: 'Slide the top U-channel over the panel tops. This ties the wall ring together and provides the roof seat.',
  },
  {
    n: '14',
    title: 'Install roof purlins',
    desc: 'Span lightweight purlins (timber or steel) across the top channel from wall to wall.',
  },
  {
    n: '15',
    title: 'Lay the roof sheets',
    desc: 'Place corrugated roof sheets perpendicular to the purlins with a 15 cm overhang on each side.',
  },
  {
    n: '16',
    title: 'Rivet the roof',
    desc: 'Rivet each roof sheet to every purlin it crosses. Use ridge-cap sheets at the apex.',
  },
  {
    n: '17',
    title: 'Frame the door & windows',
    desc: 'Cut the panel at the opening, slide in the steel sub-frame, and rivet it to the adjacent panels.',
  },
  {
    n: '18',
    title: 'Move in',
    desc: 'From first panel to move-in: 72 hours. Two materials. Zero skilled labour. One dignified home.',
    dynamic: 'finish',
  },
];

// Attach custom image path (if one exists in public/guide/) to each step
const stepsWithImg = steps.map(s => ({ ...s, img: stepImg(s.n) }));
---

<Base title="Build Guide — Lamina POP">

  <!-- ── Yellow scroll progress bar ────────────────────────── -->
  <div
    id="g-progress"
    aria-hidden="true"
    class="pointer-events-none fixed inset-x-0 top-0 z-50 h-[3px] bg-[#FFD600]"
    style="width:0; transition:none;"
  ></div>

  <!-- ── Top bar ─────────────────────────────────────────────── -->
  <div class="fixed inset-x-0 top-0 z-40 flex h-[52px] items-center justify-between px-5 mix-blend-multiply">
    <a
      href="/"
      class="text-[11px] font-semibold uppercase tracking-[0.16em] text-[#0A0A0A]/30 transition-colors hover:text-[#0A0A0A]"
    >
      ← Lamina POP
    </a>
    <span id="g-counter" class="hidden text-[11px] font-semibold uppercase tracking-[0.16em] text-[#0A0A0A]/30 md:block">
      Step
      <span id="g-counter-num" class="mx-1 font-['Space_Grotesk'] text-sm font-bold text-[#0A0A0A]">—</span>
      / 18
    </span>
  </div>

  <!-- ── Cover ──────────────────────────────────────────────── -->
  <section
    id="g-cover"
    class="relative flex min-h-screen flex-col items-center justify-center overflow-hidden bg-white px-8 py-32 text-center"
  >
    <p id="cov-eye" class="mb-8 text-[11px] font-semibold uppercase tracking-[0.28em] text-[#0A0A0A]/30">
      Assembly Guide
    </p>

    <h1
      id="cov-title"
      class="font-['Space_Grotesk'] text-[clamp(5rem,22vw,20rem)] font-bold leading-[0.86] tracking-[-0.04em] text-[#0A0A0A]"
    >
      LAMINA<br>
      <span class="relative inline-block">
        POP
        <span aria-hidden="true" class="absolute -bottom-2 left-0 right-0 -z-10 h-4 bg-[#FFD600]"></span>
      </span>
    </h1>

    <!-- Floor plan preview (shown when calculator data is loaded) -->
    <div id="g-plan-preview" class="mt-12 hidden w-full max-w-xl">
      <div class="border border-[#EBEBEB] bg-[#F9F9F9] p-2">
        <img id="g-plan-img" src="" alt="Your floor plan" class="block w-full object-contain" style="max-height:38vh" />
      </div>
      <p id="g-plan-dims" class="mt-2.5 text-[10px] font-semibold uppercase tracking-[0.22em] text-[#0A0A0A]/30"></p>
    </div>

    <!-- Materials + tools -->
    <div id="cov-meta" class="mt-12 grid grid-cols-2 gap-3 text-left sm:gap-6">
      <div class="border border-[#EBEBEB] px-5 py-5">
        <p class="mb-4 text-[10px] font-semibold uppercase tracking-[0.22em] text-[#0A0A0A]/30">Materials</p>
        <ul class="space-y-2.5 text-sm font-semibold text-[#0A0A0A]">
          <li class="flex items-center gap-2.5">
            <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[#FFD600] text-[9px] font-bold">1</span>
            <span id="mat-sheet-text">Corrugated sheet</span>
          </li>
          <li class="flex items-center gap-2.5">
            <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[#FFD600] text-[9px] font-bold">2</span>
            <span id="mat-rivet-text">POP rivets</span>
          </li>
          <li id="mat-ub-item" class="hidden items-center gap-2.5">
            <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[#FFD600] text-[9px] font-bold">3</span>
            <span id="mat-ub-text">U-blocks</span>
          </li>
        </ul>
      </div>
      <div class="border border-[#EBEBEB] px-5 py-5">
        <p class="mb-4 text-[10px] font-semibold uppercase tracking-[0.22em] text-[#0A0A0A]/30">Tools</p>
        <ul class="space-y-2.5 text-sm font-semibold text-[#0A0A0A]">
          <li class="flex items-center gap-2.5">
            <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-[#EBEBEB] text-[9px] font-bold text-[#0A0A0A]/40">A</span>
            Drill
          </li>
          <li class="flex items-center gap-2.5">
            <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-[#EBEBEB] text-[9px] font-bold text-[#0A0A0A]/40">B</span>
            Rivet gun
          </li>
        </ul>
      </div>
    </div>

    <p id="cov-count" class="mt-14 text-[11px] font-semibold uppercase tracking-[0.28em] text-[#0A0A0A]/20">
      18 steps · 72 hours
    </p>

    <div id="cov-scroll" class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-3">
      <span class="text-[10px] font-semibold uppercase tracking-[0.22em] text-[#0A0A0A]/20">Begin</span>
      <div class="h-10 w-px bg-[#0A0A0A]/10"></div>
    </div>
  </section>

  <!-- ── Steps ──────────────────────────────────────────────── -->
  <div id="g-steps" class="bg-white">
    {stepsWithImg.map((s) => (
      <article
        class="guide-step grid grid-cols-1 items-start gap-8 border-t border-[#F0F0F0] px-6 py-14 md:grid-cols-[100px_1fr] md:gap-16 md:px-16 md:py-20"
        data-step={s.n}
      >
        <!-- Step badge -->
        <div class="step-badge flex items-center gap-4 md:flex-col md:items-start md:gap-0">
          <span class="step-num font-['Space_Grotesk'] text-[3rem] font-bold leading-none tracking-tight text-[#0A0A0A] md:text-[4.5rem]">
            {s.n}
          </span>
          <span class="step-bar mt-3 hidden h-[2.5px] w-7 bg-[#FFD600] md:block"></span>
          <span class="step-bar h-[2px] w-6 bg-[#FFD600] md:hidden"></span>
        </div>

        <!-- Illustration + description -->
        <div>
          <div class="step-img-wrap overflow-hidden bg-[#F7F7F7]">
            {s.img ? (
              <img
                src={s.img}
                alt={s.title}
                class="step-img block w-full object-contain"
                style="max-height:72vh"
                loading="lazy"
                decoding="async"
              />
            ) : (
            <div class="step-img flex w-full items-center justify-center p-10" style="min-height:280px" data-dyn={s.dynamic || ''}>
              {s.n === '01' && (
                <svg id="svg-step-01" viewBox="0 0 240 180" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full max-w-[320px]">
                  {/* Top-down floor plan — generic rectangle with door gap */}
                  <rect x="38" y="28" width="164" height="124" stroke="#0A0A0A" stroke-width="2.5" stroke-linejoin="round"/>
                  {/* Door gap left wall */}
                  <line x1="38" y1="28" x2="38" y2="95" stroke="white" stroke-width="5"/>
                  <line x1="38" y1="28" x2="38" y2="95" stroke="#0A0A0A" stroke-width="2.5" stroke-linecap="round"/>
                  <line x1="38" y1="115" x2="38" y2="152" stroke="#0A0A0A" stroke-width="2.5" stroke-linecap="round"/>
                  {/* Door arc */}
                  <path d="M38 95 Q56 95 56 115" stroke="#0A0A0A" stroke-width="1" stroke-dasharray="3 2.5" fill="none"/>
                  {/* Centre cross-hairs */}
                  <line x1="120" y1="28" x2="120" y2="152" stroke="#0A0A0A" stroke-width="0.7" stroke-dasharray="4 3" opacity="0.35"/>
                  <line x1="38" y1="90" x2="202" y2="90" stroke="#0A0A0A" stroke-width="0.7" stroke-dasharray="4 3" opacity="0.35"/>
                  {/* Dimension — horizontal */}
                  <line x1="38" y1="168" x2="202" y2="168" stroke="#0A0A0A" stroke-width="1"/>
                  <line x1="38" y1="164" x2="38" y2="172" stroke="#0A0A0A" stroke-width="1"/>
                  <line x1="202" y1="164" x2="202" y2="172" stroke="#0A0A0A" stroke-width="1"/>
                  {/* Dimension — vertical */}
                  <line x1="218" y1="28" x2="218" y2="152" stroke="#0A0A0A" stroke-width="1"/>
                  <line x1="214" y1="28" x2="222" y2="28" stroke="#0A0A0A" stroke-width="1"/>
                  <line x1="214" y1="152" x2="222" y2="152" stroke="#0A0A0A" stroke-width="1"/>
                </svg>
              )}
              {s.n === '02' && (
                <svg viewBox="0 0 240 180" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full max-w-[320px]">
                  {/* Ground line */}
                  <line x1="20" y1="120" x2="220" y2="120" stroke="#0A0A0A" stroke-width="2"/>
                  {/* Ground hatching */}
                  {[30,50,70,90,110,130,150,170,190,210].map(x => (
                    <line x1={x} y1="120" x2={x - 12} y2="138" stroke="#0A0A0A" stroke-width="1" opacity="0.4"/>
                  ))}
                  {/* Spirit level body */}
                  <rect x="55" y="98" width="130" height="18" rx="3" stroke="#0A0A0A" stroke-width="1.8"/>
                  {/* Bubble vial */}
                  <rect x="96" y="102" width="48" height="10" rx="5" stroke="#0A0A0A" stroke-width="1.2" fill="rgba(255,214,0,0.18)"/>
                  {/* Bubble centre */}
                  <circle cx="120" cy="107" r="4" fill="#FFD600" stroke="#0A0A0A" stroke-width="1"/>
                  {/* Level tick marks */}
                  <line x1="114" y1="102" x2="114" y2="112" stroke="#0A0A0A" stroke-width="0.8" opacity="0.5"/>
                  <line x1="126" y1="102" x2="126" y2="112" stroke="#0A0A0A" stroke-width="0.8" opacity="0.5"/>
                  {/* End handles */}
                  <rect x="42" y="103" width="14" height="8" rx="1.5" stroke="#0A0A0A" stroke-width="1.2"/>
                  <rect x="184" y="103" width="14" height="8" rx="1.5" stroke="#0A0A0A" stroke-width="1.2"/>
                </svg>
              )}
              {s.n === '03' && (
                <svg viewBox="0 0 240 180" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full max-w-[320px]">
                  {/* Top-down plan outline */}
                  <rect x="45" y="35" width="150" height="110" stroke="#0A0A0A" stroke-width="1.5" stroke-dasharray="5 3" opacity="0.45"/>
                  {/* Stakes at corners */}
                  {([[45,35],[195,35],[45,145],[195,145]] as [number,number][]).map(([x,y]) => (
                    <>
                      <circle cx={x} cy={y} r="5" fill="#FFD600" stroke="#0A0A0A" stroke-width="1.5"/>
                      <line x1={x} y1={y + 5} x2={x} y2={y + 18} stroke="#0A0A0A" stroke-width="1.5"/>
                    </>
                  ))}
                  {/* String lines */}
                  <line x1="45" y1="35" x2="195" y2="35" stroke="#0A0A0A" stroke-width="1" stroke-dasharray="3 2"/>
                  <line x1="195" y1="35" x2="195" y2="145" stroke="#0A0A0A" stroke-width="1" stroke-dasharray="3 2"/>
                  <line x1="195" y1="145" x2="45" y2="145" stroke="#0A0A0A" stroke-width="1" stroke-dasharray="3 2"/>
                  <line x1="45" y1="145" x2="45" y2="35" stroke="#0A0A0A" stroke-width="1" stroke-dasharray="3 2"/>
                </svg>
              )}
              {s.n === '04' && (
                <svg viewBox="0 0 240 180" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full max-w-[320px]">
                  {/* Soil cross-section label line */}
                  <line x1="20" y1="95" x2="220" y2="95" stroke="#0A0A0A" stroke-width="1.5" stroke-dasharray="4 3" opacity="0.3"/>
                  {/* Ground surface */}
                  <line x1="20" y1="80" x2="220" y2="80" stroke="#0A0A0A" stroke-width="2"/>
                  {/* Ground hatching */}
                  {[30,55,80,105,130,155,180,205].map(x => (
                    <line x1={x} y1="80" x2={x - 14} y2="100" stroke="#0A0A0A" stroke-width="1" opacity="0.35"/>
                  ))}
                  {/* Footing trench */}
                  <path d="M75 80 L75 130 L165 130 L165 80" stroke="#0A0A0A" stroke-width="2" fill="white"/>
                  {/* Concrete fill — cross-hatch */}
                  <rect x="75" y="80" width="90" height="50" fill="rgba(0,0,0,0.04)"/>
                  {[80,92,104,116,128,140,152,162].map(x => (
                    <line x1={x} y1="80" x2={x - 40} y2="130" stroke="#0A0A0A" stroke-width="0.8" opacity="0.25"/>
                  ))}
                  {/* Top of footing */}
                  <line x1="75" y1="80" x2="165" y2="80" stroke="#FFD600" stroke-width="3"/>
                  {/* Depth arrow */}
                  <line x1="178" y1="80" x2="178" y2="130" stroke="#0A0A0A" stroke-width="1"/>
                  <path d="M174 80 L182 80 M174 130 L182 130" stroke="#0A0A0A" stroke-width="1"/>
                </svg>
              )}
              {s.n === '05' && (
                <svg viewBox="0 0 240 180" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full max-w-[320px]">
                  {/* Top-down perimeter with U-blocks */}
                  {/* Outer wall rect */}
                  <rect x="35" y="30" width="170" height="120" stroke="#0A0A0A" stroke-width="5" fill="none" stroke-linejoin="round"/>
                  {/* Inner edge */}
                  <rect x="43" y="38" width="154" height="104" stroke="#0A0A0A" stroke-width="1" stroke-dasharray="3 2" opacity="0.3" fill="none"/>
                  {/* U-block segments along bottom wall — yellow fill */}
                  {[35,60,85,110,135,160,185].map(x => (
                    <rect x={x} y="142" width="22" height="8" fill="#FFD600" stroke="#0A0A0A" stroke-width="1"/>
                  ))}
                  {/* U-block along top */}
                  {[35,60,85,110,135,160,185].map(x => (
                    <rect x={x} y="30" width="22" height="8" fill="#FFD600" stroke="#0A0A0A" stroke-width="1"/>
                  ))}
                  {/* U-block left */}
                  {[30,52,74,96,118,140].map(y => (
                    <rect x="27" y={y} width="8" height="22" fill="#FFD600" stroke="#0A0A0A" stroke-width="1"/>
                  ))}
                  {/* U-block right */}
                  {[30,52,74,96,118,140].map(y => (
                    <rect x="205" y={y} width="8" height="22" fill="#FFD600" stroke="#0A0A0A" stroke-width="1"/>
                  ))}
                </svg>
              )}
              {s.n === '06' && (
                <svg viewBox="0 0 240 180" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full max-w-[320px]">
                  {/* Corner U-block connection — top-down detail */}
                  {/* Horizontal channel */}
                  <rect x="30" y="84" width="120" height="12" stroke="#0A0A0A" stroke-width="1.8" fill="rgba(255,214,0,0.15)"/>
                  <line x1="30" y1="90" x2="150" y2="90" stroke="#0A0A0A" stroke-width="0.7" stroke-dasharray="3 2" opacity="0.4"/>
                  {/* Vertical channel */}
                  <rect x="114" y="30" width="12" height="120" stroke="#0A0A0A" stroke-width="1.8" fill="rgba(255,214,0,0.15)"/>
                  <line x1="120" y1="30" x2="120" y2="150" stroke="#0A0A0A" stroke-width="0.7" stroke-dasharray="3 2" opacity="0.4"/>
                  {/* Corner block highlight */}
                  <rect x="114" y="84" width="12" height="12" fill="#FFD600" stroke="#0A0A0A" stroke-width="1.8"/>
                  {/* Rivets */}
                  <circle cx="105" cy="90" r="2.5" fill="#0A0A0A"/>
                  <circle cx="120" cy="76" r="2.5" fill="#0A0A0A"/>
                  {/* Cut lines showing mitre */}
                  <line x1="114" y1="84" x2="126" y2="96" stroke="#0A0A0A" stroke-width="1.2" opacity="0.5"/>
                </svg>
              )}
              {s.n === '07' && (
                <svg viewBox="0 0 240 180" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full max-w-[320px]">
                  {/* Corrugated sheet — profile / side view */}
                  {/* Wave path: 6 full corrugations */}
                  <path
                    d="M20,130 C28,130 28,50 36,50 C44,50 44,130 52,130 C60,130 60,50 68,50 C76,50 76,130 84,130 C92,130 92,50 100,50 C108,50 108,130 116,130 C124,130 124,50 132,50 C140,50 140,130 148,130 C156,130 156,50 164,50 C172,50 172,130 180,130 C188,130 188,50 196,50 C204,50 204,130 212,130 C220,130 220,50 228,50"
                    stroke="#0A0A0A" stroke-width="2.5" fill="none"
                  />
                  {/* Top flat cap */}
                  <line x1="20" y1="50" x2="20" y2="130" stroke="#0A0A0A" stroke-width="2"/>
                  {/* Baseline */}
                  <line x1="18" y1="130" x2="228" y2="130" stroke="#0A0A0A" stroke-width="1" opacity="0.3"/>
                  {/* Dimension arrows — width */}
                  <line x1="20" y1="155" x2="228" y2="155" stroke="#0A0A0A" stroke-width="1"/>
                  <path d="M20 151 L20 159 M228 151 L228 159" stroke="#0A0A0A" stroke-width="1"/>
                  {/* Height arrow */}
                  <line x1="12" y1="50" x2="12" y2="130" stroke="#0A0A0A" stroke-width="1"/>
                  <path d="M8 50 L16 50 M8 130 L16 130" stroke="#0A0A0A" stroke-width="1"/>
                  {/* "0.81 m" label position hint — yellow dot at crest */}
                  <circle cx="36" cy="50" r="3" fill="#FFD600"/>
                  <circle cx="100" cy="50" r="3" fill="#FFD600"/>
                  <circle cx="164" cy="50" r="3" fill="#FFD600"/>
                </svg>
              )}
              {s.n === '08' && (
                <svg viewBox="0 0 240 180" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full max-w-[320px]">
                  {/* Elevation view: panel inserted into floor U-block */}
                  {/* Ground / footing */}
                  <rect x="30" y="148" width="180" height="16" fill="#F0F0F0" stroke="#0A0A0A" stroke-width="1.5"/>
                  {/* U-block on footing */}
                  <path d="M80 148 L80 132 L96 132 L96 120 L144 120 L144 132 L160 132 L160 148" stroke="#0A0A0A" stroke-width="2" fill="rgba(255,214,0,0.2)"/>
                  {/* Panel (corrugated outline) going into channel */}
                  <rect x="96" y="30" width="48" height="90" stroke="#0A0A0A" stroke-width="2"/>
                  {/* Wave lines inside panel rect */}
                  {[104,112,120,128,136].map(x => (
                    <line x1={x} y1="30" x2={x} y2="120" stroke="#0A0A0A" stroke-width="0.7" stroke-dasharray="4 3" opacity="0.4"/>
                  ))}
                  {/* Arrow showing direction */}
                  <path d="M120 18 L120 27" stroke="#0A0A0A" stroke-width="2" stroke-linecap="round"/>
                  <path d="M114 22 L120 30 L126 22" stroke="#0A0A0A" stroke-width="1.5" fill="none" stroke-linejoin="round"/>
                  {/* Highlight: panel base in channel */}
                  <line x1="96" y1="120" x2="144" y2="120" stroke="#FFD600" stroke-width="3"/>
                </svg>
              )}
              {s.n === '09' && (
                <svg viewBox="0 0 240 180" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full max-w-[320px]">
                  {/* Close-up: rivet through panel + U-block flange */}
                  {/* U-block flange (side cross-section) */}
